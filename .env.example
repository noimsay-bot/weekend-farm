# Supabase 신규 프로젝트 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key(sb_publishable_...) 또는 legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 작물 데이터 수집 (npm run collect, 로컬에서만 사용. Vercel에 넣지 않음) ──
# Supabase > Project Settings > API > service_role (비밀키: 절대 커밋·공유 금지)
SUPABASE_SERVICE_ROLE_KEY=
# 농사로 OpenAPI 인증키 (nongsaro.go.kr > 공공데이터 > OpenAPI 신청)
NONGSARO_API_KEY=
# 공공데이터포털 일반 인증키 (data.go.kr > '작물별 비료 표준사용량 처방 정보' 활용신청)
DATA_GO_KR_SERVICE_KEY=
# 농약안전정보시스템 OpenAPI 키 (psis.rda.go.kr > OpenAPI 이용신청)
PSIS_API_KEY=
