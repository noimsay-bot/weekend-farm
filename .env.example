# Supabase 신규 프로젝트 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key(sb_publishable_...) 또는 legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 작물 데이터 수집 (npm run collect, 로컬에서만 사용. Vercel에 넣지 않음) ──
# Supabase > Project Settings > API > service_role (비밀키: 절대 커밋·공유 금지)
SUPABASE_SERVICE_ROLE_KEY=
# 농사로 OpenAPI 인증키: 서비스마다 키가 따로 나온다 (nongsaro.go.kr > 소통/공유 > 공공데이터 개방 > 공공데이터 신청, 개발 구분 기타)
# 텃밭가꾸기 정보 (fildMnfct)
NONGSARO_GARDEN_KEY=
# 주간농사정보 (weekFarmInfo): 일일 크론이 쓰므로 Vercel에도 등록
NONGSARO_WEEKLY_KEY=
# 공공데이터포털 일반 인증키 (data.go.kr > '작물별 비료 표준사용량 처방 정보' 활용신청)
DATA_GO_KR_SERVICE_KEY=
# 농약안전정보시스템 OpenAPI 키 (psis.rda.go.kr > OpenAPI 이용신청)
PSIS_API_KEY=

# ── 서버 (Vercel 환경변수에도 등록) ──
# 크론이 service role로 DB를 갱신한다 (비밀키)
# SUPABASE_SERVICE_ROLE_KEY=  (위와 같은 값)
# 기상청 API (공공데이터포털 일반 인증키, 위 DATA_GO_KR_SERVICE_KEY와 같은 값)
# 웹 푸시 VAPID 키: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://weekend-farm.vercel.app
# 크론 엔드포인트 보호용 임의 문자열 (Vercel Cron이 Authorization: Bearer로 보냄)
CRON_SECRET=
